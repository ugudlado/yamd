{
  "name": "yamd",
  "version": "0.2.0",
  "private": true,
  "description": "Yet Another Movie Discovery - Indian Movie Discovery Engine",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w packages/web",
    "dev:api": "npm run dev -w packages/api",
    "dev:mobile": "npm run start -w packages/mobile",
    "build": "npm run build -w packages/shared && npm run build -w packages/api && npm run build -w packages/web",
    "build:web": "npm run build -w packages/web",
    "build:api": "npm run build -w packages/api",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "mcp:dev": "tsx mcp/server.ts",
    "mcp:build": "esbuild mcp/server.ts --bundle --platform=node --outfile=dist/mcp-server.js",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "concurrently": "^8.2.2",
    "esbuild": "^0.19.9",
    "prisma": "^5.7.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
